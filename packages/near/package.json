{
  "name": "@bound/near",
  "version": "0.1.0",
  "description": "Bound on NEAR: verify an AI agent's surety certificate (reserve, auditor stake, coverage, key confinement) before dealing with it. Library, CLI and MCP server for NEAR testnet.",
  "keywords": [
    "near",
    "near-protocol",
    "ai-agents",
    "agents",
    "surety",
    "mcp",
    "model-context-protocol",
    "bound-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamnotdou/bound.git",
    "directory": "packages/near"
  },
  "homepage": "https://near.boundprotocol.dev/docs",
  "bugs": {
    "url": "https://github.com/iamnotdou/bound/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "bin": {
    "bound-near": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./testnet.json": "./data/testnet.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data/testnet.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "deploy": "tsx scripts/deploy.ts",
    "demo": "tsx scripts/demo.ts",
    "status": "tsx scripts/status.ts",
    "verify": "tsx scripts/verify.ts",
    "evidence": "tsx scripts/evidence.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root .",
    "mcp": "tsx scripts/mcp.ts",
    "mcp-smoke": "tsx scripts/mcp-smoke.ts",
    "agent-mcp": "tsx scripts/agent-mcp-demo.ts",
    "sync-deployment": "tsx scripts/sync-deployment.ts"
  },
  "dependencies": {
    "near-api-js": "7.5.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
