# Copy this file to .env.testnet and fill in real values.
# .env.testnet is git-ignored — NEVER commit secret keys.
#
# Public configuration (network, contract ids, actor G... addresses) lives in
# deployments/testnet.json and is committed. This file is secrets only.

# Optional network selector — defaults to testnet. Must match a key in
# deployments/ and the DEPLOYMENTS map in app/lib/deployments.ts.
# STELLAR_NETWORK=testnet

# Secret keys (S...) — keep private, never commit
OPERATOR_SECRET=
AGENT_SECRET=
AUDITOR_SECRET=
CHALLENGER_SECRET=
COUNTERPARTY_SECRET=

# API keys
# Direct Anthropic key (sk-ant-...) or a gateway key (e.g. openllm.sh sk-llm-...).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Anthropic-compatible gateway base URL (ends in /v1). Leave unset for
# Anthropic directly. For openllm.sh use: https://www.openllm.sh/v1
# ANTHROPIC_BASE_URL=https://www.openllm.sh/v1
# Optional model id override for the gateway catalog.
# ANTHROPIC_MODEL=plus
