{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  // The generated bindings and the committed deployments file live outside this
  // package and are reached by relative path, then inlined by tsup. tsc follows
  // those imports, so they are checked without being listed here.
  "include": ["src/**/*.ts", "tsup.config.ts"],
  "exclude": ["node_modules", "dist"]
}
