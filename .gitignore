# ── Secrets — NEVER commit (these hold the 5 account secret keys + API key) ──
.env
.env.*
!.env.example
*.bak
*.bak-*

# ── Node / Next.js ──
node_modules/
.next/
out/
packages/*/dist/
next-env.d.ts
*.tsbuildinfo

# ── Rust / Soroban ──
target/

# ── OS / editor ──
.DS_Store
*.log

# ── Soroban test snapshots for the cross-contract harness ──
# Per-contract snapshots are committed (they are ~15 KB each and useful in
# review). The integration harness registers six contracts in one Env, so each
# of its snapshots is ~63 KB — ~1.1 MB of generated JSON that nothing asserts
# on. It is regenerated by `cargo test`; keeping it out of the repo keeps the
# diff readable.
contracts/integration-tests/test_snapshots/

# Same reasoning for the PaymentRouter's own unit tests: each one registers a
# Stellar Asset Contract and a mock Registry alongside the router, so its
# snapshots are ~35 KB each — ~900 KB of generated JSON that nothing asserts on.
contracts/payment-router/test_snapshots/

# And the same for the PremiumVault, which registers a Stellar Asset Contract
# and a mock Registry per test: ~776 KB of generated JSON that nothing asserts
# on.
contracts/premium-vault/test_snapshots/
