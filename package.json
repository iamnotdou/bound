{
  "name": "bound-protocol",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "build": "pnpm build:sdk && pnpm --filter dashboard build",
    "build:sdk": "pnpm --filter @bound/sdk build",
    "start": "pnpm --filter dashboard start",
    "setup": "ts-node --project scripts/tsconfig.json scripts/setup-accounts.ts",
    "deploy": "ts-node --project scripts/tsconfig.json scripts/deploy-all.ts",
    "demo": "ts-node --project scripts/tsconfig.json scripts/demo.ts",
    "mcp": "ts-node --transpile-only --project scripts/tsconfig.json mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "cargo test",
    "lint:contracts": "cargo clippy --all-targets -- -D warnings",
    "format:contracts": "cargo fmt --check",
    "format:contracts:fix": "cargo fmt",
    "build:contracts": "stellar contract build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:sdk && tsc --noEmit -p tsconfig.json && pnpm --filter @bound/sdk typecheck && pnpm --filter dashboard typecheck",
    "tools-smoke": "ts-node --transpile-only --project scripts/tsconfig.json scripts/tools-smoke.ts",
    "sdk-smoke": "ts-node --transpile-only --project scripts/tsconfig.json scripts/sdk-smoke.ts",
    "mcp-smoke": "ts-node --transpile-only --project scripts/tsconfig.json scripts/mcp-smoke.ts",
    "routes-smoke": "ts-node --transpile-only --project scripts/tsconfig.json scripts/routes-smoke.ts",
    "wallet-smoke": "ts-node --transpile-only --project scripts/tsconfig.json scripts/wallet-smoke.ts",
    "test:e2e": "pnpm tools-smoke && pnpm sdk-smoke && pnpm mcp-smoke && pnpm routes-smoke && pnpm wallet-smoke",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm format:contracts && pnpm lint:contracts && pnpm test:contracts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@bound/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stellar/stellar-sdk": "^14.6.1",
    "ai": "^4.3.16",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
